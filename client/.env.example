# From repo root run: npm install (npm workspaces — one lockfile at project root)
# Dev — API on port 5000 (recommended)
VITE_API_BASE=http://localhost:5000/api

# Dev — same-origin: use /api only if vite.config.js proxies /api and /uploads to :5000
# VITE_API_BASE=/api

# Production — Express serves SPA + API on one host
# VITE_API_BASE=/api

# After changing vite.config.js, restart: npm run dev

