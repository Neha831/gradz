# The repo folder can be named anything (e.g. gradezy). Client reaches this API by URL in client/.env (VITE_API_BASE), not by folder path.
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/gradezy
JWT_SECRET=replace_with_strong_secret
# Comma-separated if you use both localhost and 127.0.0.1 in the browser
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Production: serve built React SPA from Express (same folder layout: repo/client/dist)
# SERVE_CLIENT=true
# CLIENT_DIST=../client/dist
# CORS_ORIGIN=http://localhost:5000

# Optional legacy MySQL migration settings
MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=u245386400_fourise_exam
MIGRATE_BATCH_SIZE=1000
VERIFY_SAMPLE_SIZE=10
MIGRATION_STATUS_FILE=./migration-status.json
MIGRATION_REPORTS_DIR=./migration-reports
MIGRATION_TAIL_LINES=30
MIGRATION_DOCTOR_TIMEOUT_MS=8000

